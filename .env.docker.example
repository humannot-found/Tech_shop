# Docker Compose local defaults.
# Copy this file to .env or merge these values into your existing .env before running Docker.

POSTGRES_DB=tech_shop_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

BACKEND_PORT=8000
ADMIN_FRONTEND_PORT=5173
WEBSITE_PORT=5174

TECH_SHOP_ENVIRONMENT=development
TECH_SHOP_JWT_SECRET_KEY=replace-with-a-long-random-secret-for-local-dev
TECH_SHOP_JWT_ALGORITHM=HS256
TECH_SHOP_ACCESS_TOKEN_MINUTES=60
TECH_SHOP_REFRESH_TOKEN_DAYS=7
TECH_SHOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

ADMIN_VITE_API_BASE_URL=http://localhost:8000/api/v1/staff
WEBSITE_VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BRAND_NAME=Crystal-shop

DEMO_SEED_PASSWORD=DemoPass123!

TECH_SHOP_MPESA_ENVIRONMENT=sandbox
TECH_SHOP_MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
TECH_SHOP_MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
TECH_SHOP_MPESA_PASSKEY=replace-with-daraja-passkey
TECH_SHOP_MPESA_SHORTCODE=174379
TECH_SHOP_MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
TECH_SHOP_MPESA_CALLBACK_BASE_URL=https://your-ngrok-url.ngrok-free.app
